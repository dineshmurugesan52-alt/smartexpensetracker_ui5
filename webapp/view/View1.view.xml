            <GenericTile
                id="_IDGenGenericTile"
                header="Total expense"
                subheader="This month"
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tilelayout"
            >
                <TileContent
                    id="_IDGenTileContent"
                    unit="₹"
                    footer=""
                >
                    <NumericContent
                        id="_IDGenNumericContent"
                        value="{view>/monthly/totalExpense}"
                        withMargin="false"
                        valueColor="Good"
                    />
                </TileContent>
            </GenericTile>
            <GenericTile
                id="_IDGenGenericTile1"
                header="Total Food expense"
                subheader="This month"
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tilelayout"
            >
                <TileContent
                    id="_IDGenTileContent2"
                    unit="₹"
                    footer=""
                >
                    <NumericContent
                        id="_IDGenNumericContent1"
                        value="{view>/monthly/food}"
                        withMargin="false"
                    />
                </TileContent>
            </GenericTile>
            <GenericTile
                id="_IDGenGenericTile2"
                header="Total Travel expense"
                subheader="This month"
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tilelayout"
            >
                <TileContent
                    id="_IDGenTileContent3"
                    unit="₹"
                    footer=""
                >
                    <NumericContent
                        id="_IDGenNumericContent2"
                        value="{view>/monthly/travel}"
                        withMargin="false"
                    />
                </TileContent>
            </GenericTile>
            <GenericTile
                id="_IDGenGenericTile3"
                header="Total Accommodation expense"
                subheader="This month"
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tilelayout"
            >
                <TileContent
                    id="_IDGenTileContent4"
                    unit="₹"
                    footer=""
                >
                    <NumericContent
                        id="_IDGenNumericContent3"
                        value="{view>/monthly/accommodation}"
                        withMargin="false"
                    />
                </TileContent>
            </GenericTile>
            <GenericTile
                id="_IDGenGenericTile4"
                header="Total Others expense"
                subheader="This month"
                class="sapUiTinyMarginBegin sapUiTinyMarginTop sapUiSizeCompact sapUiResponsiveContentPadding sapUiTinyMarginBottom tilelayout"
            >
                <TileContent
                    id="_IDGenTileContent5"
                    unit="₹"
                    footer=""
                >
                    <NumericContent
                        id="_IDGenNumericContent4"
                        value="{view>/monthly/others}"
                        withMargin="false"
                    />
                </TileContent>
            </GenericTile>

            <ScrollContainer
                id="tableScroll"
                height="500px"
                vertical="true"
                horizontal="false"
            >
                <Table
                    id="expenseTable"
                    items="{path: 'expense>/Expenses', parameters: { $$operationMode: 'Server' }}"
                >
                    <columns>
                        <Column id="_IDGenColumn">
                            <Text
                                id="_IDGenText2"
                                text="Category"
                            />
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text
                                id="_IDGenText3"
                                text="Amount"
                            />
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text
                                id="_IDGenText4"
                                text="Date"
                            />
                        </Column>

                        <Column id="_IDGenColumn3">
                            <Text
                                id="_IDGenText5"
                                text="Description"
                            />
                        </Column>
                        <Column id="_IDGenColumn4">
                            <Text
                                id="_IDGenText11"
                                text="Actions"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            id="_IDGenColumnListItem"
                            press=".onExpensePress"
                            type="Active"
                        >
                            <cells>
                                <Text
                                    id="_IDGenText6"
                                    text="{expense>category}"
                                />
                                <Text
                                    id="_IDGenText7"
                                    text="{expense>amount}"
                                />
                                <Text
                                    id="_IDGenText8"
                                    text="{expense>date}"
                                />
                                <Text
                                    id="_IDGenText9"
                                    text="{expense>note}"
                                />
                                <Button
                                    id="_IDGenButton"
                                    icon="sap-icon://delete"
                                    press=".onDelete"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
            <viz:VizFrame
                id="expenseChart"
                vizType="stacked_column"
                height="500px"
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset
                        id="_IDGenFlattenedDataset"
                        data="{expense>/ExpenseChart}"
                    >
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                id="_IDGenDimensionDefinition"
                                name="Date"
                                value="{expense>date}"
                            />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition1"
                                name="Food"
                                value="{expense>food}"
                            />

                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition2"
                                name="Travel"
                                value="{expense>travel}"
                            />

                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition3"
                                name="Accommodation"
                                value="{expense>accommodation}"
                            />

                            <viz.data:MeasureDefinition
                                id="_IDGenMeasureDefinition4"
                                name="Others"
                                value="{expense>others}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem"
                        uid="valueAxis"
                        type="Measure"
                        values="Food,Travel,Accommodation,Others"
                    />

                    <viz.feeds:FeedItem
                        id="_IDGenFeedItem1"
                        uid="categoryAxis"
                        type="Dimension"
                        values="Date"
                    />
                </viz:feeds>
            </viz:VizFrame>
        </content>
    </Page>
</mvc:View>
