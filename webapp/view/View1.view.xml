    <ScrollContainer
    id="tableScroll"
    height="500px"
    vertical="true"
    horizontal="false">
            <Table
                id="expenseTable"
                items="{expense>/Expenses}"
            >
                <columns>
                    <Column id="_IDGenColumn">
                        <Text
                            id="_IDGenText2"
                            text="Category"
                        />
                    </Column>

                    <Column id="_IDGenColumn1">
                        <Text
                            id="_IDGenText3"
                            text="Amount"
                        />
                    </Column>

                    <Column id="_IDGenColumn2">
                        <Text
                            id="_IDGenText4"
                            text="Date"
                        />
                    </Column>

                    <Column id="_IDGenColumn3">
                        <Text
                            id="_IDGenText5"
                            text="Description"
                        />
                    </Column>
                    <Column id="_IDGenColumn4" >
                        <Text
                            id="_IDGenText11"
                            text="Actions"
                        />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem" press=".onExpensePress" type="Active">
                        <cells>
                            <Text
                                id="_IDGenText6"
                                text="{expense>category}"
                            />
                            <Text
                                id="_IDGenText7"
                                text="{expense>amount}"
                            />
                            <Text
                                id="_IDGenText8"
                                text="{expense>date}"
                            />
                            <Text
                                id="_IDGenText9"
                                text="{expense>note}"
                            />
                            <Button id="_IDGenButton"
                    text="{expense>amount}"
                    press=".onDelete" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            </ScrollContainer >
            <viz:VizFrame
                id="expenseChart"
                vizType="stacked_column"
                height="500px"
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset id="_IDGenFlattenedDataset" data="{expense>/ExpenseChart}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition id="_IDGenDimensionDefinition"
                                name="Date"
                                value="{expense>date}"
                            />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition1"
                                name="Food"
                                value="{expense>food}"
                            />

                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition2"
                                name="Travel"
                                value="{expense>travel}"
                            />

                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition3"
                                name="Accommodation"
                                value="{expense>accommodation}"
                            />

                            <viz.data:MeasureDefinition id="_IDGenMeasureDefinition4"
                                name="Others"
                                value="{expense>others}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem id="_IDGenFeedItem"
                        uid="valueAxis"
                        type="Measure"
                        values="Food,Travel,Accommodation,Others"
                    />

                    <viz.feeds:FeedItem id="_IDGenFeedItem1"
                        uid="categoryAxis"
                        type="Dimension"
                        values="Date"
                    />
                </viz:feeds>
            </viz:VizFrame>
        </content>
    </Page>
</mvc:View>
