                id="monthYearSelect"
                items="{
                    path: 'monthsModel>/months'
                }"
                change=".onMonthYearChange">
                <core:Item id="_IDGenItem5"
                    xmlns:core="sap.ui.core"
                    key="{monthsModel>key}"
                    text="{monthsModel>text}" />
