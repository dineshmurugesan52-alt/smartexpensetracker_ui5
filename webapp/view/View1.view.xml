    <headerContent>
      <Button id="_IDGenButton6" icon="sap-icon://navigation-left-arrow" press="onPrevMonth" />
      <Text id="_IDGenText" text="{mock>/month}" class="sapUiSmallMarginBeginEnd" />
      <Button id="_IDGenButton7" icon="sap-icon://navigation-right-arrow" press="onNextMonth" />
      <Button id="_IDGenButton8" text="Add expense" icon="sap-icon://add" type="Emphasized" press="onAddExpense" class="sapUiSmallMarginBegin" />
    </headerContent>

        <content>

