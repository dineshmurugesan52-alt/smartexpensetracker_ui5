        <headerContent>
            <Button
                id="_IDGenButton6"
                icon="sap-icon://navigation-left-arrow"
                press="onPrevMonth"
            />
            
            <DatePicker width="10rem" id="_IDGenDatePicker" valueFormat="yyyy-MM" displayFormat="MMMM yyyy" change=".onMonthYearChange" placeholder="Select month"></DatePicker>
            <Button
                id="_IDGenButton7"
                icon="sap-icon://navigation-right-arrow"
                press="onNextMonth"
            />
            <Button
                id="_IDGenButton8"
                text="Add expense"
                icon="sap-icon://add"
                type="Emphasized"
                press="onAddExpense"
                class="sapUiSmallMarginBegin"
            />
        </headerContent>

        <content>
            <!-- <Toolbar id="_IDGenToolbar2"> 
        <Title id="_IDGenTitle" 
            text="Daily Expense Overview" 
            level="H2" /> 
 
        <ToolbarSpacer id="_IDGenToolbarSpacer2" /> 
 
